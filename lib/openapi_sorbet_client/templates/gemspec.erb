# frozen_string_literal: true

require_relative "lib/<%= gem_name %>/version"

Gem::Specification.new do |spec|
  spec.name = "<%= gem_name %>"
  spec.version = <%= module_name %>::VERSION
  spec.authors = ["OpenAPI Sorbet Client Generator"]
  spec.summary = <%= "Generated client for #{document.title}".inspect %>
  spec.homepage = "https://github.com/astathis/openapi-sorbet-client"
  spec.license = "MIT"
  spec.required_ruby_version = ">= 3.2.0"
  spec.files = Dir["lib/**/*", "sorbet/config"]
  spec.require_paths = ["lib"]

  spec.add_dependency "faraday", "~> 2.0"
  spec.add_dependency "sorbet-runtime", ">= 0.5", "< 1"
end
