# typed: strict
# frozen_string_literal: true

module <%= module_name %>
  module Models
    class <%= OpenapiSorbetClient::Naming.schema_class_name(schema.name) %> < T::Struct
      extend T::Sig
      include WireHelpers

<% schema.properties.each do |property| -%>
      const :<%= property.name %>, <%= emitter.property_type(property, defined_names: defined_names) %>
<% end -%>

      WIRE_KEY_MAP = T.let(
        {
<% schema.properties.each do |property| -%>
          <%= property.name %>: <%= property.wire_key.inspect %>,
<% end -%>
        }.freeze,
        T::Hash[Symbol, String]
      )

      WIRE_TYPE_MAP = T.let(
        {
<% schema.properties.each do |property| -%>
          <%= property.name %>: <%= emitter.wire_type_descriptor(property.schema) %>,
<% end -%>
        }.freeze,
        T::Hash[Symbol, T.untyped]
      )

      WIRE_REQUIRED_MAP = T.let(
        {
<% schema.properties.each do |property| -%>
          <%= property.name %>: <%= property.required == true %>,
<% end -%>
        }.freeze,
        T::Hash[Symbol, T::Boolean]
      )

<% constrained_properties = schema.properties.select { |property| property.max_length } -%>
<% if constrained_properties.any? -%>
      # Constraints the live API enforces but its OpenAPI spec doesn't declare. See the
      # overrides file this gem was generated with for the observed behavior behind each one.
      WIRE_MAX_LENGTH_MAP = T.let(
        {
<% constrained_properties.each do |property| -%>
          <%= property.name %>: <%= property.max_length %>,
<% end -%>
        }.freeze,
        T::Hash[Symbol, Integer]
      )

      #: (**untyped) -> void
      def initialize(**kwargs)
        super
        WIRE_MAX_LENGTH_MAP.each do |field, max_length|
          value = public_send(field)
          next unless value.is_a?(String) && value.length > max_length

          raise ArgumentError, "#{field} is #{value.length} characters, exceeds the #{max_length} character limit enforced by the API"
        end
      end
<% end -%>

      sig do
        params(payload: T::Hash[String, T.untyped])
          .returns(<%= OpenapiSorbetClient::Naming.schema_class_name(schema.name) %>)
      end
      def self.from_wire(payload)
        from_wire_payload(payload)
      end
    end
  end
end
